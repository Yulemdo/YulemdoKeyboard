<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_app_gradient"
    android:padding="28dp"
    android:gravity="center">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_full_name"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/fire_2"
        android:letterSpacing="-0.02"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="O'zbek tilidagi shaxsiy klaviaturangiz"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1) Klaviaturani tizimda yoqing  ·  2) Keyboard tanlovida &quot;Keyboard&quot; ni tanlang"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:background="@drawable/bg_glass_button"
        android:padding="16dp"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnEnableIme"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Klaviaturalar sozlamasini ochish"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:background="@drawable/bg_fire_button"
        android:elevation="2dp" />

    <Button
        android:id="@+id/btnSwitchIme"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:text="Klaviatura tanlash"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:background="@drawable/bg_glass_button" />

    <Button
        android:id="@+id/btnEditor"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:text="Klaviatura muharriri"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:background="@drawable/bg_glass_button" />

</LinearLayout>
